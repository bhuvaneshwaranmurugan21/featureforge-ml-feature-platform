{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:featureforge:stage5-activation-decision:v1",
  "title": "FeatureForge composite activation decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "feature_set", "generation_id", "operation_id", "validation_receipt_digest", "expected_generation", "expected_version", "evaluated_at", "evidence_digests", "input_digest", "status", "reason_codes", "decision_digest"],
  "properties": {
    "contract": {"const": "stage5-activation-decision-v1"},
    "feature_set": {"type": "string", "minLength": 1},
    "generation_id": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "validation_receipt_digest": {"$ref": "#/$defs/digest"},
    "expected_generation": {"type": ["string", "null"]},
    "expected_version": {"type": "integer", "minimum": 0},
    "evaluated_at": {"type": "integer", "minimum": 0},
    "evidence_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
    "input_digest": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["ELIGIBLE", "REJECTED"]},
    "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "decision_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
