{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:featureforge:stage6-cost-envelope:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "currency", "pricing_observed_at_epoch", "lines", "subtotal_microusd", "safety_margin_bps", "worst_case_microusd", "maximum_microusd", "admitted"],
  "properties": {
    "contract": {"const": "stage6-cost-envelope-v1"},
    "currency": {"const": "USD"},
    "pricing_observed_at_epoch": {"type": "integer", "minimum": 0},
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "quantity_millionths", "unit_cost_microusd", "extended_microusd"],
        "properties": {
          "component": {"type": "string", "minLength": 1, "maxLength": 128},
          "quantity_millionths": {"type": "integer", "minimum": 0},
          "unit_cost_microusd": {"type": "integer", "minimum": 0},
          "extended_microusd": {"type": "integer", "minimum": 0}
        }
      }
    },
    "subtotal_microusd": {"type": "integer", "minimum": 0},
    "safety_margin_bps": {"const": 2000},
    "worst_case_microusd": {"type": "integer", "minimum": 0},
    "maximum_microusd": {"type": "integer", "minimum": 1, "maximum": 25000000},
    "admitted": {"type": "boolean"}
  }
}
