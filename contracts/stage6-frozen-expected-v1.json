{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:featureforge:stage6-frozen-expected:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "execution_id", "manifest_digest", "source_sha256", "definitions", "definitions_digest", "rows", "rows_digest"],
  "properties": {
    "contract": {"const": "stage6-frozen-expected-v1"},
    "execution_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "definitions_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rows_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "definitions": {"type": "array", "minItems": 1, "maxItems": 500000, "items": {"type": "object"}},
    "rows": {
      "type": "array", "minItems": 1, "maxItems": 500000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["customer_id", "feature_name", "value", "event_time", "knowledge_time", "definition_digest", "generation_id"],
        "properties": {
          "customer_id": {"type": "string", "minLength": 1},
          "feature_name": {"type": "string", "minLength": 1},
          "value": {"type": ["number", "null"]},
          "event_time": {"type": "integer", "minimum": 0},
          "knowledge_time": {"type": "integer", "minimum": 0},
          "definition_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "generation_id": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
