{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:featureforge:online-validation-receipt:v1",
  "title": "FeatureForge online candidate validation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "feature_set",
    "generation_id",
    "operation_id",
    "source_digest",
    "offline_rows_digest",
    "definition_set_digest",
    "plan_digest",
    "actual_count",
    "actual_digest",
    "receipt_digest"
  ],
  "properties": {
    "contract": {"const": "online-validation-receipt-v1"},
    "feature_set": {"type": "string", "minLength": 1},
    "generation_id": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "source_digest": {"$ref": "#/$defs/digest"},
    "offline_rows_digest": {"$ref": "#/$defs/digest"},
    "definition_set_digest": {"$ref": "#/$defs/digest"},
    "plan_digest": {"$ref": "#/$defs/digest"},
    "actual_count": {"type": "integer", "minimum": 0},
    "actual_digest": {"$ref": "#/$defs/digest"},
    "receipt_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
