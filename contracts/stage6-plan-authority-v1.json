{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:featureforge:stage6-plan-authority:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "source_commit", "source_tree", "variable_digest", "provider_lock_digest", "state_lineage_fingerprint", "state_serial", "account_fingerprint", "region", "artifact_digests", "inventory_digest", "lease_digest", "binary_plan_sha256", "normalized_plan_sha256", "created_at_epoch", "expires_at_epoch"],
  "properties": {
    "contract": {"const": "stage6-plan-authority-v1"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "variable_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider_lock_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state_lineage_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state_serial": {"type": "integer", "minimum": 0},
    "account_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "region": {"type": "string", "pattern": "^[a-z]{2}(-gov)?-[a-z]+-[0-9]+$"},
    "artifact_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "inventory_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lease_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binary_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "normalized_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at_epoch": {"type": "integer", "minimum": 0},
    "expires_at_epoch": {"type": "integer", "minimum": 1}
  }
}
