{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:featureforge:validation-receipt:v1",
  "title": "FeatureForge persisted validation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["actual_count", "actual_digest", "artifact_links_valid", "candidate_matches_manifest", "contract", "expected_artifact_digest", "expected_artifact_id", "expected_count", "expected_digest", "generation_id", "generation_manifest_digest", "matched"],
  "properties": {
    "actual_count": {"type": "integer", "minimum": 0},
    "actual_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_links_valid": {"type": "boolean"},
    "candidate_matches_manifest": {"type": "boolean"},
    "contract": {"const": "validation-receipt-v1"},
    "expected_artifact_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_artifact_id": {"type": "string", "minLength": 1},
    "expected_count": {"type": "integer", "minimum": 0},
    "expected_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generation_id": {"type": "string", "minLength": 1},
    "generation_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "matched": {"type": "boolean"}
  }
}
