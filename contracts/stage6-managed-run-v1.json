{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:featureforge:stage6-managed-run:v1",
  "title": "FeatureForge Stage 6 managed run",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "run_id", "source_commit", "source_tree", "region", "account_fingerprint", "namespace", "inputs", "output_bucket", "output_prefix", "artifact_digests", "max_input_rows", "max_output_rows", "max_cost_microusd", "safety_margin_bps", "manifest_digest"],
  "properties": {
    "contract": {"const": "stage6-managed-run-v1"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "region": {"type": "string"},
    "account_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "namespace": {"type": "string", "minLength": 1, "maxLength": 128},
    "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/s3Object"}},
    "output_bucket": {"type": "string"},
    "output_prefix": {"type": "string"},
    "artifact_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "max_input_rows": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "max_output_rows": {"type": "integer", "minimum": 1, "maximum": 500000},
    "max_cost_microusd": {"type": "integer", "minimum": 1},
    "safety_margin_bps": {"type": "integer", "minimum": 0, "maximum": 5000},
    "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "s3Object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket", "key", "version_id", "sha256"],
      "properties": {
        "bucket": {"type": "string"},
        "key": {"type": "string"},
        "version_id": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
